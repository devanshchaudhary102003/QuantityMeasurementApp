{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "THIS_IS_A_SUPER_SECRET_KEY_1234567890",
    "Issuer": "QuantityMeasurementApp.Api",
    "Audience": "QuantityMeasurementApp.Api"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "quantity-route": {
        "ClusterId": "quantity-cluster",
        "Match": { "Path": "/api/quantity/{**catch-all}" }
      },
      "history-route": {
        "ClusterId": "history-cluster",
        "Match": { "Path": "/api/history/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": { "Address": "http://localhost:5001/" }
        }
      },
      "quantity-cluster": {
        "Destinations": {
          "quantity-destination": { "Address": "http://localhost:5002/" }
        }
      },
      "history-cluster": {
        "Destinations": {
          "history-destination": { "Address": "http://localhost:5003/" }
        }
      }
    }
  }
}
